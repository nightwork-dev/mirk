{
  "name": "@mirk/store",
  "version": "0.13.0",
  "type": "module",
  "description": "Code-split key-value, collection, vector, full-text search, append-only log, graph, and SQL storage ports with in-memory references and a shared-connection SQLite adapter.",
  "license": "Apache-2.0",
  "keywords": [
    "storage",
    "key-value",
    "collection-store",
    "vector",
    "vector-search",
    "full-text-search",
    "append-only-log",
    "graph",
    "graph-traversal",
    "similarity",
    "cosine",
    "sqlite",
    "embeddings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/store"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/store#readme",
  "bugs": "https://github.com/nightwork-dev/mirk/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./kv": {
      "import": "./dist/kv.js",
      "types": "./dist/kv.d.ts"
    },
    "./atomic": {
      "import": "./dist/atomic.js",
      "types": "./dist/atomic.d.ts"
    },
    "./transaction": {
      "import": "./dist/transaction.js",
      "types": "./dist/transaction.d.ts"
    },
    "./vector": {
      "import": "./dist/vector.js",
      "types": "./dist/vector.d.ts"
    },
    "./search": {
      "import": "./dist/search.js",
      "types": "./dist/search.d.ts"
    },
    "./log": {
      "import": "./dist/log.js",
      "types": "./dist/log.d.ts"
    },
    "./graph": {
      "import": "./dist/graph.js",
      "types": "./dist/graph.d.ts"
    },
    "./sql": {
      "import": "./dist/sql.js",
      "types": "./dist/sql.d.ts"
    },
    "./coordination": {
      "import": "./dist/coordination.js",
      "types": "./dist/coordination.d.ts"
    },
    "./encrypted": {
      "import": "./dist/encrypted.js",
      "types": "./dist/encrypted.d.ts"
    },
    "./sqlite": {
      "import": "./dist/adapters/sqlite.js",
      "types": "./dist/adapters/sqlite.d.ts"
    },
    "./node-sqlite": {
      "import": "./dist/adapters/node-sqlite.js",
      "types": "./dist/adapters/node-sqlite.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "build": "rm -rf dist && tsup src/index.ts src/kv.ts src/atomic.ts src/transaction.ts src/vector.ts src/search.ts src/log.ts src/graph.ts src/sql.ts src/coordination.ts src/encrypted.ts src/adapters/sqlite.ts src/adapters/node-sqlite.ts --format esm --dts --external better-sqlite3 --external node:sqlite",
    "conformance:gen": "tsx scripts/gen-conformance.ts",
    "conformance:current": "tsx scripts/check-conformance-current.ts"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0 || ^12.0.0 || ^13.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mirk/fixtures": "workspace:^",
    "@types/better-sqlite3": "^7.6.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.0.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
