{
  "name": "@mirk/store",
  "version": "0.8.0",
  "type": "module",
  "description": "Code-split key-value, collection, vector, full-text search, graph, and SQL storage ports with in-memory references and a shared-connection SQLite adapter.",
  "license": "Apache-2.0",
  "keywords": [
    "storage",
    "key-value",
    "collection-store",
    "vector",
    "vector-search",
    "full-text-search",
    "graph",
    "graph-traversal",
    "similarity",
    "cosine",
    "sqlite",
    "sqlite-vec",
    "embeddings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/store"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/store#readme",
  "bugs": "https://github.com/nightwork-dev/mirk/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./kv": {
      "import": "./dist/kv.js",
      "types": "./dist/kv.d.ts"
    },
    "./vector": {
      "import": "./dist/vector.js",
      "types": "./dist/vector.d.ts"
    },
    "./search": {
      "import": "./dist/search.js",
      "types": "./dist/search.d.ts"
    },
    "./graph": {
      "import": "./dist/graph.js",
      "types": "./dist/graph.d.ts"
    },
    "./sql": {
      "import": "./dist/sql.js",
      "types": "./dist/sql.d.ts"
    },
    "./coordination": {
      "import": "./dist/coordination.js",
      "types": "./dist/coordination.d.ts"
    },
    "./sqlite": {
      "import": "./dist/adapters/sqlite.js",
      "types": "./dist/adapters/sqlite.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsup src/index.ts src/kv.ts src/vector.ts src/search.ts src/graph.ts src/sql.ts src/coordination.ts src/adapters/sqlite.ts --format esm --dts --external better-sqlite3 --external sqlite-vec"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0 || ^12.0.0",
    "sqlite-vec": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^11.0.0",
    "sqlite-vec": "0.1.9",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
