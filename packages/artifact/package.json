{
  "name": "@mirk/artifact",
  "version": "0.1.0",
  "type": "module",
  "description": "Domain-neutral artifact identity, integrity, lineage, and object-storage coordination.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./store": {
      "import": "./dist/store.js",
      "types": "./dist/store.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts src/store.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mirk/store": "workspace:*",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
