{
  "name": "@mirk/store-markdown",
  "version": "0.1.1",
  "type": "module",
  "description": "Human-editable Markdown and YAML headmatter adapter for @mirk/store.",
  "license": "Apache-2.0",
  "keywords": [
    "storage",
    "markdown",
    "yaml",
    "frontmatter",
    "git",
    "mirk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/store-markdown"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/store-markdown#readme",
  "bugs": "https://github.com/nightwork-dev/mirk/issues",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsup src/index.ts --format esm --dts --external yaml"
  },
  "dependencies": {
    "@mirk/store": "workspace:^",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "dependencies": {
      "@mirk/store": "^0.8.0",
      "yaml": "^2.8.1"
    }
  }
}
