{
  "name": "@mirk/sqlite-vec-native",
  "version": "0.14.0",
  "type": "module",
  "description": "Pinned sqlite-vec with ordered float64 cosine for Mirk SQLite adapters.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "install.js",
    "dist/native/*.c",
    "dist/native/*.h",
    "dist/native/*.patch",
    "dist/native/provenance.json",
    "dist/native/LICENSE"
  ],
  "scripts": {
    "prepack": "python3 ../../native/sqlite-vec/prepare.py dist/native",
    "build": "python3 ../../native/sqlite-vec/prepare.py dist/native && node install.js",
    "install": "node install.js",
    "typecheck": "tsc --allowJs --checkJs --noEmit --module nodenext --target es2022 index.js install.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
