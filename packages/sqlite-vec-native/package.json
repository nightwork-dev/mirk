{
  "name": "@mirk/sqlite-vec-native",
  "version": "0.15.0",
  "type": "module",
  "description": "Pinned sqlite-vec with ordered float64 cosine for Mirk SQLite adapters.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "install.js",
    "dist/native/*.c",
    "dist/native/*.h",
    "dist/native/*.patch",
    "dist/native/provenance.json",
    "dist/native/LICENSE",
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "scripts": {
    "prepack": "python3 ../../native/sqlite-vec/prepare.py dist/native && tsup src/index.ts --format esm --dts",
    "build": "python3 ../../native/sqlite-vec/prepare.py dist/native && node install.js && tsup src/index.ts --format esm --dts",
    "install": "node install.js",
    "typecheck": "tsc --noEmit --module nodenext --target es2022 src/index.ts && tsc --allowJs --checkJs --noEmit --module nodenext --target es2022 install.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "tsup": "^9.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/sqlite-vec-native"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/sqlite-vec-native#readme",
  "bugs": {
    "url": "https://github.com/nightwork-dev/mirk/issues"
  }
}
