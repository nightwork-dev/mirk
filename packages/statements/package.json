{
  "name": "@mirk/statements",
  "version": "0.2.0",
  "type": "module",
  "description": "Production storage adapter for statements/v1 records, admission receipts, bitemporal indexes, and legacy dual-read parity harnesses.",
  "license": "Apache-2.0",
  "keywords": [
    "statements",
    "storage",
    "sqlite",
    "provenance",
    "bitemporal",
    "admission"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/statements"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/statements#readme",
  "bugs": "https://github.com/nightwork-dev/mirk/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sqlite": {
      "import": "./dist/sqlite.js",
      "types": "./dist/sqlite.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsup src/index.ts src/sqlite.ts src/testing.ts src/types.ts --format esm --dts --external better-sqlite3"
  },
  "dependencies": {
    "@mirk/store": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^11.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
