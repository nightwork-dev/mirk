{
  "name": "@mirk/store-indexeddb",
  "version": "0.2.0",
  "type": "module",
  "description": "IndexedDB source adapter for @mirk/store's async key-value, collection, and atomic mutation ports.",
  "license": "Apache-2.0",
  "keywords": [
    "storage",
    "key-value",
    "collection-store",
    "indexeddb",
    "offline",
    "atomic-mutation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/store-indexeddb"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/store-indexeddb#readme",
  "bugs": {
    "url": "https://github.com/nightwork-dev/mirk/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run --exclude 'src/**/*.browser.test.ts' && pnpm test:browser",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsup src/index.ts --format esm --dts"
  },
  "dependencies": {
    "@mirk/store": "workspace:^"
  },
  "devDependencies": {
    "@vitest/browser": "3.2.6",
    "playwright": "1.61.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  }
}
