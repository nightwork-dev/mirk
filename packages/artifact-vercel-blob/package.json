{
  "name": "@mirk/artifact-vercel-blob",
  "version": "0.13.0",
  "type": "module",
  "description": "Private Vercel Blob object-storage adapter for @mirk/artifact.",
  "license": "Apache-2.0",
  "keywords": [
    "artifact",
    "object-storage",
    "vercel",
    "vercel-blob"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/artifact-vercel-blob"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/artifact-vercel-blob#readme",
  "bugs": "https://github.com/nightwork-dev/mirk/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format esm --dts --external @vercel/blob",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mirk/artifact": "workspace:^"
  },
  "peerDependencies": {
    "@vercel/blob": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/blob": "^2.8.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "tsup": "^9.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
