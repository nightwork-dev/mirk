{
  "name": "@mirk/fixtures",
  "version": "0.4.3",
  "type": "module",
  "description": "Typed, layered, explainable authored data with memory, filesystem, package-resource, and store sources.",
  "license": "Apache-2.0",
  "keywords": [
    "fixtures",
    "authored-data",
    "configuration",
    "content-packs",
    "schema-validation",
    "standard-schema",
    "layering",
    "patches",
    "provenance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/fixtures"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/fixtures#readme",
  "bugs": "https://github.com/nightwork-dev/mirk/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mirk-fixtures": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./memory": {
      "import": "./dist/sources/memory.js",
      "types": "./dist/sources/memory.d.ts"
    },
    "./filesystem": {
      "import": "./dist/sources/filesystem.js",
      "types": "./dist/sources/filesystem.d.ts"
    },
    "./package": {
      "import": "./dist/sources/package.js",
      "types": "./dist/sources/package.d.ts"
    },
    "./store": {
      "import": "./dist/sources/store.js",
      "types": "./dist/sources/store.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:exports": "node ./test/export-map-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsup src/index.ts src/cli.ts src/bin.ts src/sources/memory.ts src/sources/filesystem.ts src/sources/package.ts src/sources/store.ts --format esm --dts && node ./test/export-map-smoke.mjs"
  },
  "devDependencies": {
    "@mirk/store": "workspace:^",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  }
}
