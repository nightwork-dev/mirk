{
  "name": "@mirk/store-postgres",
  "version": "0.1.2",
  "type": "module",
  "description": "PostgreSQL source adapter for @mirk/store's async key-value and collection ports.",
  "license": "Apache-2.0",
  "keywords": [
    "storage",
    "key-value",
    "collection-store",
    "postgres",
    "postgresql",
    "jsonb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/mirk.git",
    "directory": "packages/store-postgres"
  },
  "homepage": "https://github.com/nightwork-dev/mirk/tree/main/packages/store-postgres#readme",
  "bugs": "https://github.com/nightwork-dev/mirk/issues",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsup src/index.ts --format esm --dts --external pg"
  },
  "dependencies": {
    "@mirk/store": "workspace:^",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "dependencies": {
      "@mirk/store": "^0.8.0",
      "pg": "^8.22.0"
    }
  }
}
