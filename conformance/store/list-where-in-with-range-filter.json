{
  "id": "store/list-where-in-with-range-filter",
  "title": "listWhereIn applies a range in its filter and rejects an invalid bound",
  "ports": [
    "collection"
  ],
  "capabilities": [
    "listWhereIn"
  ],
  "steps": [
    {
      "op": "ensureIndex",
      "args": [
        "items",
        "kind"
      ],
      "expect": {
        "value": null
      }
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "1",
          "at": 1,
          "kind": "a"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "2",
          "at": 2,
          "kind": "b"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "3",
          "at": 3,
          "kind": "a"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "4",
          "at": 4,
          "kind": "c"
        }
      ]
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "kind",
        [
          "a",
          "b"
        ],
        {
          "where": {
            "at": {
              "lte": 3
            }
          },
          "sortBy": "at",
          "sortDir": "desc"
        }
      ],
      "expect": {
        "ids": [
          "3",
          "2",
          "1"
        ]
      }
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "kind",
        [
          "a"
        ],
        {
          "where": {
            "at": {
              "gte": null
            }
          }
        }
      ],
      "expect": {
        "throws": "Store range bounds must be finite numbers or strings."
      }
    }
  ]
}
