{
  "id": "store/collection-get-by-id",
  "title": "getById returns the item stored under that id",
  "ports": [
    "collection"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "put",
      "args": [
        "projects",
        {
          "id": "p1",
          "name": "alpha",
          "category": "ai",
          "priority": 1,
          "pinned": true
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "projects",
        {
          "id": "p2",
          "name": "bravo",
          "category": "ai",
          "priority": 2,
          "pinned": false
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "projects",
        {
          "id": "p3",
          "name": "charlie",
          "category": "web",
          "priority": 3,
          "pinned": true
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "projects",
        {
          "id": "p4",
          "name": "delta",
          "category": "web",
          "priority": 4,
          "pinned": true
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "projects",
        {
          "id": "p5",
          "name": "echo",
          "category": "ops",
          "priority": 5,
          "pinned": false
        }
      ]
    },
    {
      "op": "getById",
      "args": [
        "projects",
        "p2"
      ],
      "expect": {
        "value": {
          "id": "p2",
          "name": "bravo",
          "category": "ai",
          "priority": 2,
          "pinned": false
        }
      }
    }
  ]
}
