{
  "id": "store/list-where-in-sorted-and-paged",
  "title": "listWhereIn applies where, sortBy, limit and offset to the matching rows",
  "ports": [
    "collection"
  ],
  "capabilities": [
    "listWhereIn"
  ],
  "steps": [
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "1",
          "f": "a",
          "rank": 3,
          "kind": "keep"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "2",
          "f": "b",
          "rank": 1,
          "kind": "keep"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "3",
          "f": "c",
          "rank": 2,
          "kind": "keep"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "4",
          "f": "a",
          "rank": 4,
          "kind": "drop"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "5",
          "f": "b",
          "kind": "keep"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "6",
          "f": "z",
          "rank": 0,
          "kind": "keep"
        }
      ]
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "f",
        [
          "a",
          "b",
          "c"
        ],
        {
          "where": {
            "kind": "keep"
          },
          "sortBy": "rank",
          "sortDir": "desc"
        }
      ],
      "expect": {
        "ids": [
          "1",
          "3",
          "2",
          "5"
        ]
      }
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "f",
        [
          "a",
          "b",
          "c"
        ],
        {
          "where": {
            "kind": "keep"
          },
          "sortBy": "rank",
          "limit": 2,
          "offset": 1
        }
      ],
      "expect": {
        "ids": [
          "3",
          "1"
        ]
      }
    }
  ]
}
