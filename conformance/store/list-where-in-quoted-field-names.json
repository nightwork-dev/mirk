{
  "id": "store/list-where-in-quoted-field-names",
  "title": "field names containing a single quote, a dot or a backslash name one top-level key",
  "ports": [
    "collection"
  ],
  "capabilities": [
    "listWhereIn"
  ],
  "steps": [
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "a",
          "it's": "x",
          "a.b": "dot",
          "back\\slash'quote": "v"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "b",
          "it's": "y",
          "a": {
            "b": "dot"
          },
          "back\\slash'quote": "w"
        }
      ]
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "back\\slash'quote",
        [
          "v"
        ]
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "it's",
        [
          "x"
        ]
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "a.b",
        [
          "dot"
        ]
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "x') OR 1=1 --",
        [
          "x"
        ]
      ],
      "expect": {
        "ids": []
      }
    }
  ]
}
