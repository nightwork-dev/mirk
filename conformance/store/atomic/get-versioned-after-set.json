{
  "id": "store/atomic/get-versioned-after-set",
  "title": "a plain set mints the first version token of the store",
  "ports": [
    "atomic",
    "kv"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "set",
      "args": [
