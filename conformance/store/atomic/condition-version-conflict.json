{
  "id": "store/atomic/condition-version-conflict",
  "title": "a stale version condition conflicts and observes the current token",
  "ports": [
    "atomic",
    "kv"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "set",
      "args": [
        "a",
        1
      ]
    },
    {
      "op": "mutateAtomically",
      "args": [
        {
          "conditions": [
            {
              "target": {
                "kind": "key",
                "key": "a"
              },
              "expected": "version",
              "version": "conformance-v9"
            }
          ],
          "operations": [
            {
              "op": "set",
              "key": "b",
              "value": 2
            }
          ]
        }
      ],
      "expect": {
        "value": {
          "status": "conflict",
          "condition": {
            "target": {
              "kind": "key",
              "key": "a"
            },
            "expected": "version",
            "version": "conformance-v9"
          },
          "observed": "conformance-v1"
        }
      }
    },
    {
      "op": "getVersioned",
      "args": [
        {
          "kind": "key",
          "key": "b"
        }
      ],
      "expect": {
        "value": null
      }
    },
    {
      "op": "set",
      "args": [
        "c",
        3
      ]
    },
    {
      "op": "getVersioned",
      "args": [
        {
          "kind": "key",
          "key": "c"
        }
      ],
      "expect": {
        "value": {
          "value": 3,
          "version": "conformance-v2"
        }
      }
    }
  ]
}
