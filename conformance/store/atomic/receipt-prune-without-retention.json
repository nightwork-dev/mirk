{
  "id": "store/atomic/receipt-prune-without-retention",
  "title": "without a retention window an explicit prune removes nothing and receipts still replay",
  "ports": [
    "atomic"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "mutateAtomically",
      "args": [
        {
          "operations": [
            {
              "op": "set",
              "key": "job",
              "value": {
                "step": 1
              }
            }
          ],
          "idempotency": {
            "key": "job-1",
            "outcome": {
              "done": true
            }
          }
        }
      ],
      "expect": {
        "value": {
          "status": "applied",
          "requestDigest": "8f4faf7ec7514bde32fb3c46804b5ed23e37c9f67670d908b7b12e9313deb653",
          "versions": [
            {
              "target": {
                "kind": "key",
                "key": "job"
              },
              "version": "conformance-v1"
            }
          ],
          "outcome": {
            "done": true
          }
        }
      }
    },
    {
      "op": "pruneExpiredReceipts",
      "args": [],
      "expect": {
        "value": 0
      }
    },
    {
      "op": "mutateAtomically",
      "args": [
        {
          "operations": [
            {
              "op": "set",
              "key": "job",
              "value": {
                "step": 1
              }
            }
          ],
          "idempotency": {
            "key": "job-1",
            "outcome": {
              "done": true
            }
          }
        }
      ],
      "expect": {
        "value": {
          "status": "replayed",
          "requestDigest": "8f4faf7ec7514bde32fb3c46804b5ed23e37c9f67670d908b7b12e9313deb653",
          "versions": [
            {
              "target": {
                "kind": "key",
                "key": "job"
              },
              "version": "conformance-v1"
            }
          ],
          "outcome": {
            "done": true
          }
        }
      }
    }
  ]
}
