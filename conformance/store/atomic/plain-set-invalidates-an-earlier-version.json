{
  "id": "store/atomic/plain-set-invalidates-an-earlier-version",
  "title": "a version read before a plain set no longer satisfies a condition, so the plain write is never lost",
  "ports": [
    "atomic",
    "kv"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "set",
      "args": [
        "a",
        1
      ]
    },
    {
      "op": "getVersioned",
      "args": [
        {
          "kind": "key",
          "key": "a"
        }
      ],
      "expect": {
        "value": {
          "value": 1,
          "version": "conformance-v1"
        }
      }
    },
    {
      "op": "set",
      "args": [
        "a",
        2
      ]
    },
    {
      "op": "mutateAtomically",
      "args": [
        {
          "conditions": [
            {
              "target": {
                "kind": "key",
                "key": "a"
              },
              "expected": "version",
              "version": "conformance-v1"
            }
          ],
          "operations": [
            {
              "op": "set",
              "key": "a",
              "value": 3
            }
          ]
        }
      ],
      "expect": {
        "value": {
          "status": "conflict",
          "condition": {
            "target": {
              "kind": "key",
              "key": "a"
            },
            "expected": "version",
            "version": "conformance-v1"
          },
          "observed": "conformance-v2"
        }
      }
    },
    {
      "op": "get",
      "args": [
        "a"
      ],
      "expect": {
        "value": 2
      }
    }
  ]
}
