{
  "id": "store/list-where-in-empty-values",
  "title": "an empty values list returns nothing without querying",
  "ports": [
    "collection"
  ],
  "capabilities": [
    "listWhereIn"
  ],
  "steps": [
    {
      "op": "put",
      "args": [
        "items",
        {
          "id": "a",
          "f": "x"
        }
      ]
    },
    {
      "op": "listWhereIn",
      "args": [
        "items",
        "f",
        []
      ],
      "expect": {
        "ids": []
      }
    }
  ]
}
