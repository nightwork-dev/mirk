{
  "id": "markdown/preamble-and-sections",
  "title": "preamble and sections",
  "ports": [
    "store_markdown"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {
          "preset": "notes"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "documents",
        {
          "id": "note-1",
          "title": "First Note",
          "status": "draft",
          "summary": "Opening paragraph.",
          "details": "Details here."
        }
      ]
    },
    {
      "op": "getById",
      "args": [
        "documents",
        "note-1"
      ],
      "expect": {
        "value": {
          "id": "note-1",
          "title": "First Note",
          "status": "draft",
          "summary": "Opening paragraph.",
          "details": "Details here."
        }
      }
    },
    {
      "op": "fileContains",
      "args": [
        "docs/first-note.md",
        "## Details\n\nDetails here."
      ],
      "expect": {
        "value": true
      }
    },
    {
      "op": "fileContains",
      "args": [
        "docs/INDEX.md",
        "- note-1 · First Note · draft"
      ],
      "expect": {
        "value": true
      }
    }
  ]
}
