{
  "id": "markdown/index-updates-after-remove",
  "title": "index updates after remove",
  "ports": [
    "store_markdown"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {
          "preset": "notes"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "documents",
        {
          "id": "note-1",
          "title": "First Note",
          "status": "draft",
          "summary": "Opening paragraph.",
          "details": "Details here."
        }
      ]
    },
    {
      "op": "remove",
      "args": [
        "documents",
        "note-1"
      ]
    },
    {
      "op": "fileContains",
      "args": [
        "docs/INDEX.md",
        "note-1"
      ],
      "expect": {
        "value": false
      }
    },
    {
      "op": "fileContains",
      "args": [
        "docs/INDEX.md",
        "# Notes"
      ],
      "expect": {
        "value": true
      }
    },
    {
      "op": "files",
      "args": [],
      "expect": {
        "value": [
          "docs/INDEX.md"
        ]
      }
    }
  ]
}
