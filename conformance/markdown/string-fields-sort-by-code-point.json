{
  "id": "markdown/string-fields-sort-by-code-point",
  "title": "string fields sort by code point",
  "ports": [
    "store_markdown"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {}
      ]
    },
    {
      "op": "put",
      "args": [
        "things",
        {
          "id": "a",
          "label": "🌱"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "things",
        {
          "id": "b",
          "label": "�"
        }
      ]
    },
    {
      "op": "list",
      "args": [
        "things",
        {
          "sortBy": "label"
        }
      ],
      "expect": {
        "value": [
          {
            "id": "b",
            "label": "�"
          },
          {
            "id": "a",
            "label": "🌱"
          }
        ]
      }
    },
    {
      "op": "list",
      "args": [
        "things",
        {
          "sortBy": "label",
          "sortDir": "desc"
        }
      ],
      "expect": {
        "value": [
          {
            "id": "a",
            "label": "🌱"
          },
          {
            "id": "b",
            "label": "�"
          }
        ]
      }
    }
  ]
}
