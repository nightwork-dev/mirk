{
  "id": "markdown/custom-index-rejects-malformed-record",
  "title": "custom index rejects malformed record",
  "ports": [
    "store_markdown"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {
          "preset": "notes",
          "indexFileName": "catalog.md"
        }
      ]
    },
    {
      "op": "writeFile",
      "args": [
        "docs/catalog.md",
        "---\nid: [\n---\n"
      ]
    },
    {
      "op": "failure",
      "args": [
        "put",
        [
          "documents",
          {
            "id": "note-1",
            "title": "First Note",
            "status": "draft",
            "summary": "Opening paragraph.",
            "details": "Details here."
          }
        ]
      ],
      "expect": {
        "value": {
          "code": "invalid-frontmatter"
        }
      }
    },
    {
      "op": "files",
      "args": [],
      "expect": {
        "value": [
          "docs/catalog.md"
        ]
      }
    },
    {
      "op": "fileContains",
      "args": [
        "docs/catalog.md",
        "id: ["
      ],
      "expect": {
        "value": true
      }
    }
  ]
}
