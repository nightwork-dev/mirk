{
  "id": "markdown/custom-filename-collision",
  "title": "custom filename collision",
  "ports": [
    "store_markdown"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {
          "preset": "notes"
        }
      ]
    },
    {
      "op": "put",
      "args": [
        "documents",
        {
          "id": "note-1",
          "title": "First Note",
          "status": "draft",
          "summary": "Opening paragraph.",
          "details": "Details here."
        }
      ]
    },
    {
      "op": "failure",
      "args": [
        "put",
        [
          "documents",
          {
            "id": "note-2",
            "title": "First Note",
            "status": "draft",
            "summary": "Opening paragraph.",
            "details": "Details here."
          }
        ]
      ],
      "expect": {
        "value": {
          "code": "filename-collision"
        }
      }
    },
    {
      "op": "count",
      "args": [
        "documents"
      ],
      "expect": {
        "value": 1
      }
    }
  ]
}
