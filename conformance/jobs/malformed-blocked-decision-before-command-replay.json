{
  "id": "jobs/malformed-blocked-decision-before-command-replay",
  "title": "blocked decision shape validation precedes lookup of an already used command key",
  "ports": [
    "jobs"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "enqueueCommand",
      "args": [
        {
          "id": "job",
          "queue": "q",
          "payload": null
        },
        "used-key"
      ]
    },
    {
      "op": "resolveBlockedCommand",
      "args": [
        "job",
        {
          "state": "cancelled",
          "result": "unexpected"
        },
        "used-key"
      ],
      "expect": {
        "throws": "invalid-input"
      }
    },
    {
      "op": "resolveBlockedCommand",
      "args": [
        "job",
        {},
        "used-key"
      ],
      "expect": {
        "throws": "invalid-input"
      }
    },
    {
      "op": "get",
      "args": [
        "job"
      ],
      "expect": {
        "value": {
          "attempt": 0,
          "availableAt": 100,
          "cancellation": null,
          "checkpoint": null,
          "enqueuedAt": 100,
          "error": null,
          "expiresAt": null,
          "generation": 0,
          "id": "job",
          "ownerToken": null,
          "payload": null,
          "priority": 0,
          "queue": "q",
          "result": null,
          "schemaVersion": 1,
          "state": "queued",
          "updatedAt": 100
        }
      }
    }
  ]
}
