{
  "id": "vector/search-topk-limits-results",
  "title": "topK caps the result count at the nearest documents",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "near",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "mid",
          "vectors": {
            "default": [
              1,
              1,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "far",
          "vectors": {
            "default": [
              0,
              1,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "topK": 2
        }
      ],
      "expect": {
        "ids": [
          "near",
          "mid"
        ]
      }
    }
  ]
}
