{
  "id": "vector/where-filters-before-scoring",
  "title": "where keeps only documents matching every condition",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "upsertMany",
      "args": [
        "pets",
        [
          {
            "id": "cat-black",
            "vector": [
              1,
              0,
              0
            ],
            "metadata": {
              "type": "cat",
              "color": "black"
            }
          },
          {
            "id": "cat-white",
            "vector": [
              0.9,
              0.1,
              0
            ],
            "metadata": {
              "type": "cat",
              "color": "white"
            }
          },
          {
            "id": "dog-a",
            "vector": [
              0,
              1,
              0
            ],
            "metadata": {
              "type": "dog",
              "color": "black"
            }
          }
        ]
      ]
    },
    {
      "op": "search",
      "args": [
        "pets",
        [
          1,
          0,
          0
        ],
        {
          "where": {
            "type": "cat"
          }
        }
      ],
      "expect": {
        "ids": [
          "cat-black",
          "cat-white"
        ]
      }
    }
  ]
}
