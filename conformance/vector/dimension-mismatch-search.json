{
  "id": "vector/dimension-mismatch-search",
  "title": "searching with a query of the wrong length throws the shared mismatch message",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0,
            0
          ]
        }
      ],
      "expect": {
        "throws": "Vector dimension mismatch: expected 3, got 4"
      }
    }
  ]
}
