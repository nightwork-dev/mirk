{
  "id": "vector/literal-metadata-keys",
  "title": "metadata filters preserve literal field names and JavaScript number spelling",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          },
          "metadata": {
            "a.b": [
              1e-7,
              1e+21
            ],
            "": {
              "1": 1,
              "2": 2
            }
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "where": {
            "a.b": [
              1e-7,
              1e+21
            ],
            "": {
              "1": 1,
              "2": 2
            }
          }
        }
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
    }
  ]
}
