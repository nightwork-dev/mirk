{
  "id": "vector/search-is-per-collection",
  "title": "identical vectors in two collections do not leak across a search",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "one",
        {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "two",
        {
          "id": "b",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "one",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        }
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
    },
    {
      "op": "search",
      "args": [
        "two",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        }
      ],
      "expect": {
        "ids": [
          "b"
        ]
      }
    }
  ]
}
