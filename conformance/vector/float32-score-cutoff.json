{
  "id": "vector/float32-score-cutoff",
  "title": "distinct float64 cosine scores determine topK and the inclusive score floor",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "a-near",
          "vector": [
            1,
            0.0001,
            0
          ]
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "z-exact",
          "vector": [
            1,
            0,
            0
          ]
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "docs",
        [
          1,
          0,
          0
        ],
        {
          "topK": 1
        }
      ],
      "expect": {
        "ids": [
          "z-exact"
        ]
      }
    },
    {
      "op": "search",
      "args": [
        "docs",
        [
          1,
          0,
          0
        ],
        {
          "minScore": 1
        }
      ],
      "expect": {
        "ids": [
          "z-exact"
        ]
      }
    }
  ]
}
