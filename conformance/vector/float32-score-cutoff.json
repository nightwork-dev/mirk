{
  "id": "vector/float32-score-cutoff",
  "title": "distinct float64 cosine scores determine topK and the inclusive score floor",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "a-near",
          "vectors": {
            "default": [
              1,
              0.0001,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "z-exact",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "topK": 1
        }
      ],
      "expect": {
        "ids": [
          "z-exact"
        ]
      }
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "minScore": 1
        }
      ],
      "expect": {
        "ids": [
          "z-exact"
        ]
      }
    }
  ]
}
