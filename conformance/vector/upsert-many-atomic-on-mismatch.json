{
  "id": "vector/upsert-many-atomic-on-mismatch",
  "title": "a mid-array dimension mismatch in upsertMany persists nothing",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "keep",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsertMany",
      "args": [
        "docs",
        [
          {
            "id": "b",
            "vectors": {
              "default": [
                0,
                1,
                0
              ]
            }
          },
          {
            "id": "c",
            "vectors": {
              "default": [
                0,
                0,
                1,
                1
              ]
            }
          }
        ]
      ],
      "expect": {
        "throws": "Vector dimension mismatch: expected 3, got 4"
      }
    },
    {
      "op": "count",
      "args": [
        "docs"
      ],
      "expect": {
        "value": 1
      }
    },
    {
      "op": "get",
      "args": [
        "docs",
        "b"
      ],
      "expect": {
        "value": null
      }
    },
    {
      "op": "get",
      "args": [
        "docs",
        "keep"
      ],
      "expect": {
        "value": {
          "id": "keep",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      }
    }
  ]
}
