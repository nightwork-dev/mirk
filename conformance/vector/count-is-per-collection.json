{
  "id": "vector/count-is-per-collection",
  "title": "count is scoped to its collection and zero for an unknown one",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "one",
        {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "one",
        {
          "id": "b",
          "vectors": {
            "default": [
              0,
              1,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "two",
        {
          "id": "a",
          "vectors": {
            "default": [
              0,
              0,
              1
            ]
          }
        }
      ]
    },
    {
      "op": "count",
      "args": [
        "one"
      ],
      "expect": {
        "value": 2
      }
    },
    {
      "op": "count",
      "args": [
        "two"
      ],
      "expect": {
        "value": 1
      }
    },
    {
      "op": "count",
      "args": [
        "nothing"
      ],
      "expect": {
        "value": 0
      }
    }
  ]
}
