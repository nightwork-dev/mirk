{
  "id": "vector/non-unit-round-trip",
  "title": "get preserves original vector magnitude rather than a normalized direction",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "raw",
          "vectors": {
            "default": [
              3,
              4,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "get",
      "args": [
        "docs",
        "raw"
      ],
      "expect": {
        "value": {
          "id": "raw",
          "vectors": {
            "default": [
              3,
              4,
              0
            ]
          }
        }
      }
    }
  ]
}
