{
  "id": "vector/zero-vector-stored-not-searchable",
  "title": "an all-zero stored vector is stored and counted but never scored",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "zero",
          "vectors": {
            "default": [
              0,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "unit",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "count",
      "args": [
        "docs"
      ],
      "expect": {
        "value": 2
      }
    },
    {
      "op": "has",
      "args": [
        "docs",
        "zero"
      ],
      "expect": {
        "value": true
      }
    },
    {
      "op": "get",
      "args": [
        "docs",
        "zero"
      ],
      "expect": {
        "value": {
          "id": "zero",
          "vectors": {
            "default": [
              0,
              0,
              0
            ]
          }
        }
      }
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "minScore": -1
        }
      ],
      "expect": {
        "ids": [
          "unit"
        ]
      }
    }
  ]
}
