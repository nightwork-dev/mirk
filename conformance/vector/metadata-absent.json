{
  "id": "vector/metadata-absent",
  "title": "a document upserted without metadata comes back without the field",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "get",
      "args": [
        "docs",
        "a"
      ],
      "expect": {
        "value": {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      }
    }
  ]
}
