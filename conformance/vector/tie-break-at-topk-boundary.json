{
  "id": "vector/tie-break-at-topk-boundary",
  "title": "ties at the topK boundary resolve by id, whatever order the rows went in",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "asc",
        {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "asc",
        {
          "id": "b",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "asc",
        {
          "id": "c",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "desc",
        {
          "id": "c",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "desc",
        {
          "id": "b",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "desc",
        {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "asc",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "topK": 2
        }
      ],
      "expect": {
        "ids": [
          "a",
          "b"
        ]
      }
    },
    {
      "op": "search",
      "args": [
        "desc",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "topK": 2
        }
      ],
      "expect": {
        "ids": [
          "a",
          "b"
        ]
      }
    },
    {
      "op": "search",
      "args": [
        "asc",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "topK": 1
        }
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
    },
    {
      "op": "search",
      "args": [
        "desc",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "topK": 1
        }
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
