{
  "id": "vector/where-excludes-metadata-less-document",
  "title": "a document with no metadata never satisfies a where filter",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "pets",
        {
          "id": "tagged",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          },
          "metadata": {
            "type": "cat"
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "pets",
        {
          "id": "bare",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "pets",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "where": {
            "type": "cat"
          }
        }
      ],
      "expect": {
        "ids": [
          "tagged"
        ]
      }
    }
  ]
}
