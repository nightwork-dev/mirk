{
  "id": "vector/upsert-replaces-by-id",
  "title": "upserting the same id twice keeps the second vector and one row",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "a",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          },
          "metadata": {
            "v": 1
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "a",
          "vectors": {
            "default": [
              0,
              1,
              0
            ]
          },
          "metadata": {
            "v": 2
          }
        }
      ]
    },
    {
      "op": "get",
      "args": [
        "docs",
        "a"
      ],
      "expect": {
        "value": {
          "id": "a",
          "vectors": {
            "default": [
              0,
              1,
              0
            ]
          },
          "metadata": {
            "v": 2
          }
        }
      }
    },
    {
      "op": "count",
      "args": [
        "docs"
      ],
      "expect": {
        "value": 1
      }
    }
  ]
}
