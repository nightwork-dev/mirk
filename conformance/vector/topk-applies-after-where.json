{
  "id": "vector/topk-applies-after-where",
  "title": "topK counts filtered survivors, not nearest documents overall",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsertMany",
      "args": [
        "pets",
        [
          {
            "id": "cat-1",
            "vectors": {
              "default": [
                1,
                0,
                0
              ]
            },
            "metadata": {
              "type": "cat"
            }
          },
          {
            "id": "cat-2",
            "vectors": {
              "default": [
                0.9,
                0.1,
                0
              ]
            },
            "metadata": {
              "type": "cat"
            }
          },
          {
            "id": "cat-3",
            "vectors": {
              "default": [
                0.8,
                0.2,
                0
              ]
            },
            "metadata": {
              "type": "cat"
            }
          },
          {
            "id": "dog-1",
            "vectors": {
              "default": [
                0.95,
                0.05,
                0
              ]
            },
            "metadata": {
              "type": "dog"
            }
          }
        ]
      ]
    },
    {
      "op": "search",
      "args": [
        "pets",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "where": {
            "type": "cat"
          },
          "topK": 2
        }
      ],
      "expect": {
        "ids": [
          "cat-1",
          "cat-2"
        ]
      }
    }
  ]
}
