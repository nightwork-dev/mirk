{
  "id": "vector/tie-break-astral-id",
  "title": "id tie-breaks compare Unicode code points, so an astral id sorts last",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "😀",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "z",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        }
      ],
      "expect": {
        "ids": [
          "z",
          "",
          "😀"
        ]
      }
    }
  ]
}
