{
  "id": "vector/where-not-excludes-matches",
  "title": "whereNot drops documents that satisfy every condition",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsertMany",
      "args": [
        "pets",
        [
          {
            "id": "cat-black",
            "vectors": {
              "default": [
                1,
                0,
                0
              ]
            },
            "metadata": {
              "type": "cat",
              "color": "black"
            }
          },
          {
            "id": "cat-white",
            "vectors": {
              "default": [
                0.9,
                0.1,
                0
              ]
            },
            "metadata": {
              "type": "cat",
              "color": "white"
            }
          },
          {
            "id": "dog-a",
            "vectors": {
              "default": [
                0,
                1,
                0
              ]
            },
            "metadata": {
              "type": "dog",
              "color": "black"
            }
          }
        ]
      ]
    },
    {
      "op": "search",
      "args": [
        "pets",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "whereNot": {
            "type": "cat"
          }
        }
      ],
      "expect": {
        "ids": [
          "dog-a"
        ]
      }
    },
    {
      "op": "search",
      "args": [
        "pets",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "where": {
            "type": "cat"
          },
          "whereNot": {
            "color": "black"
          }
        }
      ],
      "expect": {
        "ids": [
          "cat-white"
        ]
      }
    }
  ]
}
