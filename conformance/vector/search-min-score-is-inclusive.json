{
  "id": "vector/search-min-score-is-inclusive",
  "title": "minScore keeps a document whose score equals the floor exactly",
  "ports": [
    "vector"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "ensureSpace",
      "args": [
        "default",
        {
          "dimensions": 3
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "same",
          "vectors": {
            "default": [
              1,
              0,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "upsert",
      "args": [
        "docs",
        {
          "id": "orthogonal",
          "vectors": {
            "default": [
              0,
              1,
              0
            ]
          }
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "minScore": 1
        }
      ],
      "expect": {
        "values": [
          {
            "id": "same",
            "score": 1
          }
        ],
        "approxFields": [
          "score"
        ],
        "tol": 0.000001
      }
    },
    {
      "op": "search",
      "args": [
        "docs",
        {
          "space": "default",
          "vector": [
            1,
            0,
            0
          ]
        },
        {
          "minScore": 0
        }
      ],
      "expect": {
        "values": [
          {
            "id": "same",
            "score": 1
          },
          {
            "id": "orthogonal",
            "score": 0
          }
        ],
        "approxFields": [
          "score"
        ],
        "tol": 0.000001
      }
    }
  ]
}
