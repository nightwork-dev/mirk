{
  "id": "search/query-operators-are-ordinary-terms",
  "title": "FTS operators and quotes in a query are tokenized, not parsed",
  "ports": [
    "search"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "index",
      "args": [
        "docs",
        {
          "id": "a",
          "text": "shell scripting guide"
        }
      ]
    },
    {
      "op": "search",
      "args": [
        "docs",
        "shell \"OR\" scripting;"
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
    },
    {
      "op": "search",
      "args": [
        "docs",
        "shell AND missing"
      ],
      "expect": {
        "ids": [
          "a"
        ]
      }
    }
  ]
}
