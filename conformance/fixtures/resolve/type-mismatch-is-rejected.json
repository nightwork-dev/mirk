  "ports": [
    "fixtures"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {
          "types": [
            {
              "type": "theme",
              "directory": "themes"
            },
            {
              "type": "page",
              "directory": "pages"
            }
          ],
          "sources": [
            {
              "kind": "memory",
              "name": "pack",
              "priority": 0,
              "files": {
                "themes/dark.json": "{\"name\":\"Dark\"}"
              }
            }
          ]
        }
      ]
    },
    {
      "op": "resolveRef",
      "args": [
        {
          "$ref": "theme:dark"
