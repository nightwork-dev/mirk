{
  "id": "fixtures/layering/parse-error-keeps-neighbours-checked",
  "title": "a malformed document does not hide its neighbours: a sibling file is still checked, and a ref into the broken file is unresolved rather than missing",
  "ports": [
    "fixtures"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {
          "types": [
            {
              "type": "theme",
              "directory": "themes"
            }
          ],
          "sources": [
            {
              "kind": "memory",
              "name": "pack",
              "priority": 0,
              "files": {
                "themes/bad.json": "{ not json",
                "themes/child.json": "{\"a\":{\"$ref\":\"theme:bad\"},\"b\":{\"$ref\":\"theme:nope\"}}"
              }
            }
          ]
        }
      ]
    },
    {
      "op": "validateDiagnostics",
      "args": [],
      "expect": {
        "values": [
          {
            "fixture": "theme",
            "severity": "error",
            "code": "parse-failed",
            "source": "pack",
            "path": "themes/bad.json"
          },
          {
            "severity": "warning",
            "code": "unresolved-reference",
            "fixture": "theme:child",
            "fieldPath": "a"
          },
          {
            "severity": "error",
            "code": "missing-reference",
            "fixture": "theme:child",
            "fieldPath": "b"
          }
        ],
        "ignoreFields": [
          "message"
        ]
      }
    }
  ]
}
