{
  "id": "fixtures/layering/patch-above-base-ref-mismatch",
  "title": "a patch above the base naming a different ref throws patch-ref-mismatch (item 16)",
  "ports": [
    "fixtures"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {
          "types": [
            {
              "type": "theme",
              "directory": "themes"
            }
          ],
          "sources": [
            {
              "kind": "memory",
              "name": "base",
              "priority": 0,
              "files": {
                "themes/dark.json": "{\"name\":\"Dark\"}"
              }
            },
            {
              "kind": "memory",
              "name": "overrides",
              "priority": 1,
              "files": {
                "themes/dark.json": "{\"$patch\":\"theme:other\",\"accent\":\"red\"}"
              }
            }
          ]
        }
      ]
    },
    {
      "op": "load",
      "args": [
        "theme:dark"
      ],
      "expect": {
        "throws": "Patch declares \"$patch: theme:other\" but is being applied to \"theme:dark\"."
      }
    }
  ]
}
