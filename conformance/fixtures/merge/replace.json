{
  "id": "fixtures/merge/replace",
  "title": "replace keeps only the incoming keys (item 18)",
  "ports": [
    "fixtures"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {
          "types": [
            {
              "type": "theme",
              "directory": "themes",
              "mergeStrategy": "replace"
            }
          ],
          "sources": [
            {
              "kind": "memory",
              "name": "base",
              "priority": 0,
              "files": {
                "themes/dark.json": "{\"nested\":{\"keep\":true,\"replace\":\"base\"},\"list\":[\"base\"],\"retained\":{\"stable\":true}}"
              }
            },
            {
              "kind": "memory",
              "name": "overrides",
              "priority": 1,
              "files": {
                "themes/dark.json": "{\"$patch\":\"theme:dark\",\"nested\":{\"replace\":\"patch\"},\"list\":[\"patch\"]}"
              }
            }
          ]
        }
      ]
    },
    {
      "op": "load",
      "args": [
        "theme:dark"
      ],
      "expect": {
        "value": {
          "nested": {
            "replace": "patch"
          },
          "list": [
            "patch"
          ]
        }
      }
    }
  ]
}
