              "fieldPath": "theme"
            }
          ]
        }
      }
    },
    {
      "op": "referenceGraph",
      "args": [],
      "expect": {
        "value": {
          "nodes": [
            {
              "ref": "page:home",
              "type": "page",
              "id": "home",
              "resolved": true
            },
            {
              "ref": "theme:dark",
              "type": "theme",
              "id": "dark",
              "resolved": true
            },
            {
              "ref": "theme:missing",
              "type": "theme",
              "id": "missing",
              "resolved": false
            }
          ],
          "edges": [
            {
              "from": "page:home",
              "to": "theme:missing",
              "fieldPath": [
                "theme"
              ]
            }
          ],
          "diagnostics": []
        }
      }
    }
  ]
