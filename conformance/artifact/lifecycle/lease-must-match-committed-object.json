{
  "id": "artifact/lifecycle/lease-must-match-committed-object",
  "title": "lease must match committed object",
  "ports": [
    "artifact"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {}
      ]
    },
    {
      "op": "acquireObjectLease",
      "args": [
        {
          "objectKey": "orphan",
          "ownerId": "writer",
          "mode": "shared-writer",
