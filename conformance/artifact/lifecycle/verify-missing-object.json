{
  "id": "artifact/lifecycle/verify-missing-object",
  "title": "verify missing object",
  "ports": [
    "artifact"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "configure",
      "args": [
        {}
      ]
    },
    {
      "op": "write",
      "args": [
        {
          "bytes": "aGVsbG8=",
          "mediaType": "text/plain"
        }
      ]
    },
    {
      "op": "deleteObject",
      "args": [
        "artifacts/artifact-1"
      ]
    },
    {
      "op": "verify",
      "args": [
        "artifact-1"
      ],
      "expect": {
        "value": {
          "artifact": {
            "id": "artifact-1",
            "createdAt": 1000,
            "digest": {
              "algorithm": "sha256",
              "value": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
            },
            "sizeBytes": 5,
            "mediaType": "text/plain"
          },
          "ok": false,
          "reason": "object-missing"
        }
      }
    },
    {
      "op": "read",
      "args": [
        "artifact-1"
      ],
      "expect": {
        "throws": "artifact object missing: artifact-1"
      }
    }
  ]
}
