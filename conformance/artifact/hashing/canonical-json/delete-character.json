{
  "id": "artifact/hashing/canonical-json/delete-character",
  "title": "U+007F is emitted raw, not escaped",
  "ports": [
    "hash"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "canonicalJson",
      "args": [
        {
          "$codepoints": [
            127
          ]
        }
      ],
      "expect": {
        "value": "\"\""
      }
    },
    {
      "op": "canonicalDigest",
      "args": [
        {
          "$codepoints": [
            127
          ]
        }
      ],
      "expect": {
        "value": "6fe76740e12a93d5598fe685cb6ad3d3c94e44609065a56866b69647772026ec"
      }
    }
  ]
}
