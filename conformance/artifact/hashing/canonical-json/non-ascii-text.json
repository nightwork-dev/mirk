      ],
      "expect": {
        "value": "\"café ünï 中文\""
      }
    },
    {
      "op": "canonicalDigest",
      "args": [
        "café ünï 中文"
      ],
      "expect": {
        "value": "45e7e822afdd27e7e40f6b80bb165c0fb7396ec8e72f3bec1b5872c2d9c66aa5"
      }
    }
  ]
}
