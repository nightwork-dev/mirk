{
  "id": "artifact/hashing/canonical-json/non-ascii-text",
  "title": "accented and CJK text is emitted as raw UTF-8",
  "ports": [
    "hash"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "canonicalJson",
      "args": [
