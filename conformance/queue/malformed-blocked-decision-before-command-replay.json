{
  "id": "queue/malformed-blocked-decision-before-command-replay",
  "title": "blocked decision shape validation precedes lookup of an already used command key",
  "ports": [
    "queue"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "enqueueCommand",
      "args": [
        {
          "id": "item",
          "queue": "q",
          "payload": null
        },
        "used-key"
      ]
    },
    {
      "op": "resolveBlockedCommand",
      "args": [
        "item",
        {
          "state": "cancelled",
          "result": "unexpected"
        },
        "used-key"
      ],
      "expect": {
        "throws": "invalid-input"
      }
    },
    {
      "op": "resolveBlockedCommand",
      "args": [
        "item",
        {},
        "used-key"
      ],
      "expect": {
        "throws": "invalid-input"
      }
    },
    {
      "op": "get",
      "args": [
        "item"
      ],
      "expect": {
        "value": {
          "activeKey": null,
          "availableAt": 100,
          "cancellation": null,
          "checkpoint": null,
          "claimCount": 0,
          "enqueuedAt": 100,
          "error": null,
          "expiresAt": null,
          "generation": 0,
          "id": "item",
          "kind": null,
          "ownerToken": null,
          "payload": null,
          "priority": 0,
          "queue": "q",
          "result": null,
          "schemaVersion": 2,
          "state": "queued",
          "subject": null,
          "updatedAt": 100
        }
      }
    }
  ]
}
