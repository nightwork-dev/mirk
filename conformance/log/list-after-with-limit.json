          "limit": 0
        }
      ],
      "expect": {
        "value": []
      }
    },
    {
      "op": "list",
      "args": [
        "s",
        {
          "after": 5
        }
      ],
      "expect": {
        "value": []
      }
    },
    {
      "op": "list",
      "args": [
        "s",
        {
          "after": 99,
          "limit": 3
        }
