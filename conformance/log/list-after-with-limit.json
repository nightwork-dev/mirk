{
  "id": "log/list-after-with-limit",
  "title": "list returns entries after a sequence, in order, at most limit of them",
  "ports": [
    "log"
  ],
  "capabilities": [],
  "steps": [
    {
      "op": "append",
      "args": [
        "s",
        {
          "step": "a"
        }
      ]
    },
    {
      "op": "append",
      "args": [
        "s",
        {
          "step": "b"
        }
      ]
    },
    {
      "op": "append",
      "args": [
        "s",
        {
          "step": "c"
        }
      ]
    },
    {
      "op": "append",
      "args": [
        "s",
        {
          "step": "d"
        }
      ]
    },
    {
      "op": "append",
      "args": [
        "s",
        {
          "step": "e"
        }
      ]
    },
    {
      "op": "list",
      "args": [
        "s",
        {}
      ],
      "expect": {
        "value": [
          {
            "sequence": 1,
            "record": {
