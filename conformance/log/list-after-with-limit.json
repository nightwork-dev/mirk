        {
          "limit": 1
        }
      ],
      "expect": {
        "value": [
          {
            "sequence": 1,
            "record": {
              "step": "a"
            }
          }
        ]
      }
    },
    {
      "op": "list",
      "args": [
        "s",
        {
          "after": 3,
          "limit": 100
        }
      ],
      "expect": {
        "value": [
          {
            "sequence": 4,
            "record": {
              "step": "d"
            }
          },
          {
            "sequence": 5,
            "record": {
              "step": "e"
            }
          }
        ]
      }
