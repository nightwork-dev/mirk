            }
          },
          {
            "sequence": 2,
            "record": {
              "step": "b"
            }
          },
          {
            "sequence": 3,
            "record": {
              "step": "c"
            }
          },
          {
            "sequence": 4,
            "record": {
              "step": "d"
            }
          },
          {
            "sequence": 5,
            "record": {
              "step": "e"
            }
          }
        ]
      }
    },
    {
      "op": "list",
      "args": [
        "s",
        {
          "after": 2
        }
      ],
      "expect": {
        "value": [
          {
            "sequence": 3,
            "record": {
              "step": "c"
            }
          },
          {
            "sequence": 4,
            "record": {
              "step": "d"
            }
          },
          {
            "sequence": 5,
            "record": {
              "step": "e"
            }
          }
        ]
      }
    },
    {
      "op": "list",
      "args": [
        "s",
        {
          "after": 2,
          "limit": 2
        }
      ],
      "expect": {
        "value": [
          {
            "sequence": 3,
            "record": {
              "step": "c"
            }
          },
          {
            "sequence": 4,
            "record": {
              "step": "d"
            }
          }
        ]
      }
    },
    {
      "op": "list",
      "args": [
