{
  "name": "mirk",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test && pnpm test:release-checks",
    "typecheck": "pnpm -r typecheck",
    "docs:check": "node --test scripts/check-public-docs.test.mjs && node scripts/check-public-docs.mjs",
    "release:verify": "node scripts/verify-package-release.mjs",
    "release:receipt": "node scripts/verify-package-release.mjs --publication",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "conformance:gen": "pnpm --filter @mirk/store conformance:gen",
    "conformance:current": "pnpm --filter @mirk/store conformance:current",
    "audit:dependencies": "pnpm audit --registry=https://registry.npmjs.org",
    "test:release-checks": "node --test scripts/verify-package-release.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "@qdrant/js-client-rest>undici": "7.30.1",
      "nanoid@>=3 <3.3.18": "3.3.20",
      "fast-uri@>=3 <3.1.8": "3.1.9",
      "source-map-js@<1.2.2": "1.2.2",
      "zod@>=4 <4.6.6": "4.6.7"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@mirk/artifact": "workspace:*",
    "@mirk/store-markdown": "workspace:*",
    "@changesets/cli": "3.0.3",
    "tsup": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "postcss": "^8.5.23"
  }
}
