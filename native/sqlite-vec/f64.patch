+  if (sqlite3_user_data(context)) {
+    if (elementType != SQLITE_VEC_ELEMENT_TYPE_FLOAT32) {
+      sqlite3_result_error(context, "float64 cosine requires float32 vectors", -1);
+      goto finish;
+    }
+    const f32 *av = a, *bv = b;
+    double dot = 0, an = 0, bn = 0;
+    for (size_t i = 0; i < dimensions; i++) {
+      const double x = av[i], y = bv[i];
+      if (!isfinite(x) || !isfinite(y)) goto finish;
+      dot += x * y;
+      an += x * x;
+      bn += y * y;
+    }
+    if (an > 0) sqlite3_result_double(context, bn == 0 ? 0 : dot / (sqrt(an) * sqrt(bn)));
+    goto finish;
+  }
